# Code Run API Tests
# This file demonstrates how to execute code and check job status
# All executions are now async by default and return a job_id
# The job_id is saved to environment variables which are then used in the job status requests

GET http://localhost:8080/health

### Execute Go Code - Hello World
POST http://localhost:8080/api/v1/execute
Content-Type: application/json

{
  "language": "go",
  "code": "package main\nimport \"fmt\"\nfunc main() { fmt.Println(\"Hello from GoLand HTTP Client!\") }"
}

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 202, "Response status is not 202");
    });

    if (response.body.job_id) {
        client.global.set("job_id_hello", response.body.job_id);
        client.log("Saved job_id_hello: " + response.body.job_id);
    }
%}

### Check Job Status for Hello World
GET http://localhost:8080/api/v1/execute/job/{{job_id_hello}}

> {%
    client.test("Job status request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });

    client.test("Job ID in response matches requested ID", function() {
        client.assert(response.body.job_id === client.global.get("job_id_hello"), "Job ID mismatch");
    });

    client.log("Job status: " + response.body.status);
%}




### Execute Go Code - Adding Two Numbers
POST http://localhost:8080/api/v1/execute
Content-Type: application/json

{
  "language": "go",
  "code": "package main\nimport \"fmt\"\nfunc main() {\n  a := 5\n  b := 7\n  sum := a + b\n  fmt.Printf(\"The sum of %d and %d is %d\", a, b, sum)\n}"
}

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 202, "Response status is not 202");
    });

    if (response.body.job_id) {
        client.global.set("job_id_sum", response.body.job_id);
        client.log("Saved job_id_sum: " + response.body.job_id);
    }
%}

### Check Job Status for Adding Two Numbers
GET http://localhost:8080/api/v1/execute/job/{{job_id_sum}}

> {%
    client.test("Job status request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });

    client.test("Job ID in response matches requested ID", function() {
        client.assert(response.body.job_id === client.global.get("job_id_sum"), "Job ID mismatch");
    });

    client.log("Job status: " + response.body.status);
%}




### Execute Go Code - Sorting an Array
POST http://localhost:8080/api/v1/execute
Content-Type: application/json

{
  "language": "go",
  "code": "package main\nimport (\n  \"fmt\"\n  \"sort\"\n)\nfunc main() {\n  numbers := []int{9, 3, 6, 1, 7, 4, 8, 2, 5}\n  fmt.Println(\"Before sorting:\", numbers)\n  sort.Ints(numbers)\n  fmt.Println(\"After sorting:\", numbers)\n}"
}

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 202, "Response status is not 202");
    });

    if (response.body.job_id) {
        client.global.set("job_id_sort", response.body.job_id);
        client.log("Saved job_id_sort: " + response.body.job_id);
    }
%}
### Check Job Status for Sorting an Array
GET http://localhost:8080/api/v1/execute/job/{{job_id_sort}}

> {%
    client.test("Job status request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });

    client.test("Job ID in response matches requested ID", function() {
        client.assert(response.body.job_id === client.global.get("job_id_sort"), "Job ID mismatch");
    });

    client.log("Job status: " + response.body.status);
%}
